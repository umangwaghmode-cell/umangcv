@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", "Helvetica Neue", Arial, sans-serif;
  --font-display: "Inter", "Helvetica Neue", Arial, sans-serif;
  
  --color-sky-glow: rgba(56, 189, 248, 0.08);
  --color-violet-glow: rgba(139, 92, 246, 0.05);
}

@layer base {
  body {
    @apply bg-[#050505] text-white antialiased overflow-x-hidden;
  }
}

@layer utilities {
  .bg-glow-sky {
    background: radial-gradient(circle, var(--color-sky-glow) 0%, transparent 70%);
  }
  
  .bg-glow-violet {
    background: radial-gradient(circle, var(--color-violet-glow) 0%, transparent 70%);
  }
  
  .glass {
    @apply bg-white/[0.03] backdrop-blur-[12px] border border-white/[0.08] rounded-2xl;
  }
  
  .accent-text {
    @apply bg-linear-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent;
  }
  
  .btn-primary {
    @apply bg-white text-[#050505] px-6 py-3 rounded-lg font-semibold text-sm transition-all hover:bg-white/90;
  }
  
  .btn-outline {
    @apply border border-white/20 text-white px-6 py-3 rounded-lg font-semibold text-sm transition-all hover:bg-white/5;
  }

  .text-glow-sky {
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
  }
}
